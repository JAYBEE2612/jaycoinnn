<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>JayCoin</title>

    <link rel="stylesheet" href="style.css">

    <!-- Telegram Mini App SDK -->
    <script src="https://telegram.org/js/telegram-web-app.js"></script>
</head>
<body>
    <div class="app">
        <header>
            <h1>🪙 JAYCoin</h1>
            <p id="welcome">Welcome!</p>
        </header>

        <section class="balance">
            <p>Your Balance</p>
            <h2 id="coins">1000</h2>
            <span> TAP</span>
        </section>

        <button id="tapButton" class="coin">
            🪙
        </button>
        <section class="stats">

            <div class="stat">
                <span>⚡ Energy</span>
                <strong id="energy">100</strong>
            </div>

            <div class="stat">
                <span>⭐ Level</span>
                <strong id="level">1</strong>
            </div>

        </section>

        <button id="dailyButton" class="daily">
            🎁 Daily Reward
        </button>

        <p id="message"></p>

    </div>

    <script src="app.js"></script>

</body>
</html>